SELECT
  
   
    c.Name,
    c.Application_Fee_Paid__c as applicationfeepaid,
    c.Email AS ContactEmail,
    c.Program_Name__c as program,

    u.Name AS CounselorName,
    u.MobilePhone AS counselormobilephone,
    u.IsActive AS IsActive,

    c.CreatedDate AS ApplicantCreatedDate,

    a.hed__Application_Status__c AS applicationstatus,
    a.Provisional_Admission_Fee_Paid__c AS Provisional_Admission_Fee_Paid__c,

    c.Program_Batch_Name__c AS Program_Batch_Name__c,

    a.Application_Number__c AS applicationnumber,
    c.Student_Full_Name__c AS Student_Full_Name__c,

    CONCAT(
        COALESCE(c.Email, ''),
        '_',
        COALESCE(REPLACE(c.MobilePhone, '+91-', '91'), ''),
        '_534019461'
    ) AS [Subscriberkey],

    REPLACE(c.MobilePhone, '+91-', '91') AS ContactMobilePhone,

    'IN' AS Locale

FROM [hed__Application__c_Salesforce] a

INNER JOIN [Contact_Salesforce] c
    ON a.hed__Applicant__c = c.Id

LEFT JOIN [User_Salesforce] u
    ON c.OwnerId = u.Id

INNER JOIN [Lead_Salesforce] l
    ON l.ConvertedContactId = c.Id

WHERE
    c.Program_Batch_Name__c LIKE '%2027-%'
    AND a.Provisional_Admission_Fee_Paid__c = 0
    AND c.Application_Fee_Paid__c = 1
    AND u.IsActive = 1
    AND a.Partial_Paid__c = 0
    AND c.Email NOT LIKE '%test%'
    AND c.Email NOT LIKE '%yopmail%'
    AND c.CDOE__c = 0
    AND c.Name not like '%test%'
    AND c.Enrolment_Year__c = '2027'
    AND c.Primary_Application_Submitted__c = 1
