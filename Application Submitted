SELECT
CONCAT(hed__Applicant__c,'534019461') AS SubscriberKey,
Name,
hed__Applicant_Decision_Date__c,
hed__Applicant__c,
hed__Application_Date__c,
hed__Application_Decision_Date__c,
hed__Application_Status__c,
hed__Application_Type__c,
hed__Applying_To__c,
randa__Application_Review_Status__c,
Application_Number__c,
School__c,
Fee_Structure_Defined__c,
Offline_Payment_Initiated__c,
Provisional_Admission_Fee_Paid__c,
CreatedDate,
LastActivityDate,
LastModifiedDate
FROM Application_Master_DataExtension
WHERE hed__Applicant__c IS NOT NULL
AND Application_Number__c IS NOT NULL
AND hed__Application_Status__c = 'Started'
AND LastModifiedDate > '2025-11-01 00:00:01'
