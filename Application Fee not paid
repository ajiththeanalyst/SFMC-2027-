SELECT
    a.Id AS Id,
    a.Name AS Name,
    l.Program_Name__c,

    c.Name AS ApplicantName,
    c.Application_Fee_Paid__c AS Application_Fee_Paid__c,
    c.Email AS Email,
    c.MobilePhone AS MobilePhone,

    u.Name AS counselorname,
    u.MobilePhone AS ownermobilephone,
    u.IsActive AS IsActive,
    l.Primary_Source__c,

    c.CreatedDate AS ApplicantCreatedDate,

    a.hed__Application_Status__c AS hed__Application_Status__c,
    a.Provisional_Admission_Fee_Paid__c AS Provisional_Admission_Fee_Paid__c,

    c.Program_Batch_Name__c AS Program_Batch_Name__c,

    a.Application_Number__c AS Application_Number__c,
    c.Student_Full_Name__c AS Student_Full_Name__c,

    a.First_Payment_Date__c AS First_Payment_Date__c,

    c.Email + '_' +
    CASE
        WHEN c.MobilePhone LIKE '+91-%'
            THEN REPLACE(c.MobilePhone, '+91-', '91')
        WHEN c.MobilePhone LIKE '91%'
            THEN c.MobilePhone
        ELSE '91' + c.MobilePhone
    END +
    '_534019461' AS SubscriberKey,

    CASE
        WHEN c.MobilePhone LIKE '+91-%'
            THEN REPLACE(c.MobilePhone, '+91-', '91')
        WHEN c.MobilePhone LIKE '91%'
            THEN c.MobilePhone
        ELSE '91' + c.MobilePhone
    END AS ContactMobilePhone,

    'IN' AS Locale

FROM [hed__Application__c_Salesforce] a

INNER JOIN [Contact_Salesforce] c
    ON a.hed__Applicant__c = c.Id

LEFT JOIN [User_Salesforce] u
    ON c.OwnerId = u.Id

LEFT JOIN [Lead_Salesforce] l
    ON l.ConvertedContactId = c.Id

WHERE
    c.Application_Fee_Paid__c = '0'
    AND c.Program_Batch_Name__c LIKE '%2027%'
    AND c.Enrolment_Year__c = '2027'
    AND a.Application_Number__c IS NOT NULL
    AND a.Application_Number__c <> 'null'
    AND c.Email IS NOT NULL
    AND c.MobilePhone IS NOT NULL
    AND c.Email NOT LIKE '%test%'
    AND c.Email NOT LIKE '%yopmail%'
    AND c.CDOE__c = '0'
    AND c.Name not like '%test%'

    
